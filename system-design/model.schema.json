{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NGWPC/twod-fim-knowledge-base/system-design/model.schema.json",
  "title": "model.json",
  "description": "build_model output record: model definition + artifact inventory. Written LAST to base_output_path/<id>/model.json. All hashes are first-N-hex of SHA-256 (hash_algo): identity hashes 8-hex, file checksums 16-hex; see build_model-design.md for per-field preimages. Integrity of model.json itself is tracked by S3 (ETag) or a parent index, never self-referenced.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "hash_algo",
    "twod_fim_version",
    "created_at",
    "reach_id",
    "identity_hash",
    "domain_code",
    "id",
    "inputs",
    "domain",
    "identity",
    "properties",
    "assets"
  ],
  "properties": {
    "type": { "const": "model", "description": "Discriminator vs. a run record." },
    "hash_algo": { "const": "sha256", "description": "Hash function for every hash/checksum in this document. Truncation length is per-field (see build_model-design.md)." },
    "twod_fim_version": { "type": "string", "description": "Producer software version (provenance)." },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Build completion time (UTC). model.json is written last."
    },
    "reach_id": { "type": "integer" },
    "identity_hash": {
      "allOf": [{ "$ref": "#/$defs/hash8" }],
      "description": "Hash of the identity object. Stable across domain changes; results group under it."
    },
    "domain_code": {
      "type": "string",
      "pattern": "^N(0|[1-9][0-9]*)S(0|[1-9][0-9]*)E(0|[1-9][0-9]*)W(0|[1-9][0-9]*)$",
      "description": "Domain realization: grid-snapped N/S/E/W offsets in CRS units from the anchor. A grid-reference code, not a hash."
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}\\+N(0|[1-9][0-9]*)S(0|[1-9][0-9]*)E(0|[1-9][0-9]*)W(0|[1-9][0-9]*)$",
      "description": "<identity_hash>+<domain_code>. Also the folder name."
    },
    "inputs": {
      "type": "object",
      "description": "The build_model call arguments, recorded verbatim.",
      "additionalProperties": false,
      "required": ["reach_id", "db_uri", "base_output_path"],
      "properties": {
        "reach_id": { "type": "integer" },
        "db_uri": { "type": "string" },
        "base_output_path": { "type": "string" },
        "dem_source": { "type": ["string", "null"] },
        "roughness_source": { "type": ["string", "null"] },
        "other_geometries": { "type": ["array", "null"], "items": { "type": "string" } },
        "domain_buffer": { "type": ["number", "null"] },
        "grid_resolution": { "type": ["number", "null"] },
        "walk_us_dist_pct": { "type": ["number", "null"] },
        "epsg_code": { "type": ["integer", "null"] },
        "bankfull_width_multiplier": { "type": ["number", "null"] },
        "lulc_lookup": { "type": ["object", "null"], "additionalProperties": { "type": "number" } }
      }
    },
    "domain": {
      "type": "object",
      "description": "Computed domain realization.",
      "additionalProperties": false,
      "required": ["bbox", "anchor", "offsets"],
      "properties": {
        "bbox": {
          "type": "array",
          "description": "Domain bbox in native CRS [west, south, east, north].",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        },
        "anchor": {
          "type": "array",
          "description": "Grid-snapped reach centroid in native CRS [x, y]; origin the offsets are measured from.",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "offsets": {
          "type": "array",
          "description": "[N, S, E, W] grid-snapped offsets in CRS units; matches domain_token.",
          "items": { "type": "integer", "minimum": 0 },
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "identity": {
      "type": "object",
      "description": "The inputs that define model identity; hashed to identity_hash.",
      "additionalProperties": false,
      "required": [
        "sdr_commit",
        "reach_geom_hash",
        "grid_resolution",
        "epsg_code",
        "dem_source_inputs_hash",
        "roughness_source_inputs_hash",
        "lulc_lookup_dict_hash"
      ],
      "properties": {
        "sdr_commit": { "type": "string", "description": "Methodology version pin (output-determining)." },
        "reach_geom_hash": { "$ref": "#/$defs/hash8" },
        "grid_resolution": { "type": "number", "exclusiveMinimum": 0 },
        "epsg_code": { "type": "integer" },
        "dem_source_inputs_hash": { "$ref": "#/$defs/hash8" },
        "roughness_source_inputs_hash": { "$ref": "#/$defs/hash8" },
        "lulc_lookup_dict_hash": { "$ref": "#/$defs/hash8" }
      }
    },
    "properties": {
      "type": "object",
      "description": "Computed values and hydrofabric attributes (informational; not part of identity).",
      "additionalProperties": false,
      "required": ["grid", "drainage_area_sqkm", "bankfull_width_m", "upstream_reach_ids"],
      "properties": {
        "grid": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rows", "cols"],
          "properties": {
            "rows": { "type": "integer", "exclusiveMinimum": 0 },
            "cols": { "type": "integer", "exclusiveMinimum": 0 }
          }
        },
        "drainage_area_sqkm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "From the reach DB; missing/invalid raises InvalidAttributeError (no model.json written)."
        },
        "bankfull_width_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Estimated bankfull width (pre-multiplier) used to build the inflow."
        },
        "upstream_reach_ids": { "type": "array", "items": { "type": "integer" } },
        "stream_order": { "type": ["integer", "null"] },
        "length_m": { "type": ["number", "null"] },
        "slope": { "type": ["number", "null"] },
        "downstream_reach_id": { "type": ["integer", "null"] },
        "upstream_mainstem_reach_id": { "type": ["integer", "null"] }
      }
    },
    "assets": {
      "type": "object",
      "description": "One entry per output (model.json excluded), keyed by role; hrefs are the flat files under <id>/.",
      "additionalProperties": false,
      "required": ["terrain", "roughness", "centerline", "inflow", "reach_centroid", "domain"],
      "properties": {
        "terrain": { "$ref": "#/$defs/asset" },
        "roughness": { "$ref": "#/$defs/asset" },
        "centerline": { "$ref": "#/$defs/asset" },
        "inflow": { "$ref": "#/$defs/asset" },
        "reach_centroid": { "$ref": "#/$defs/asset" },
        "domain": { "$ref": "#/$defs/asset" }
      }
    },
    "warnings": {
      "type": "array",
      "description": "Non-fatal check results; the build still completes and writes model.json.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "enum": ["model_exists", "inflow_multiple_crossings", "large_domain", "uniform_roughness"]
          },
          "message": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "hash8": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$",
      "description": "First 8 hex of SHA-256 (32-bit), git-style. Identity hashes; scoped under reach_id, so collisions are confined to one reach's variants."
    },
    "checksum16": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "First 16 hex of SHA-256 (64-bit). File-integrity checksums; longer than identity hashes to allow cross-corpus content comparison."
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["href", "checksum"],
      "properties": {
        "href": {
          "type": "string",
          "description": "Path to the file, e.g. dem.tif, cl.geojson, or a full s3:// URI."
        },
        "checksum": {
          "allOf": [{ "$ref": "#/$defs/checksum16" }],
          "description": "16-hex content checksum of the file bytes (integrity)."
        },
        "source_url": {
          "type": ["string", "null"],
          "description": "External provenance URL (DEM/land-cover endpoint, or db_uri). null for purely computed assets."
        },
        "retrieved": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "When the source was fetched, if applicable."
        },
        "derived": {
          "type": "boolean",
          "default": false,
          "description": "True for outputs regenerable from sources (terrain, roughness); subject to S3 lifecycle deletion."
        }
      }
    }
  }
}
